# HydraDB — see lib/hydra-client.ts for how these are picked
HYDRA_BOLT_URL=neo4j://127.0.0.1:7687
HYDRA_AUTH_TOKEN=local-development-token-32-bytes

# Set this to use lib/hydra-http.ts instead of the Bolt client — needed when
# the app can't reach HydraDB's Bolt port directly (e.g. deployed on Vercel,
# reaching a local instance through an ngrok HTTP tunnel). Leave unset for
# local dev.
# HYDRA_HTTP_URL=https://your-tunnel.ngrok-free.dev
